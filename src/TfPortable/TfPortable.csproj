<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>tfp</AssemblyName>
    <RootNamespace>TfPortable</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyTitle>TfPortable</AssemblyTitle>
    <Description>Portable replacement for the TFVC part of tf.exe: PAT sign-in, no dialogs, JSON output.</Description>
    <!-- Costura resolves the embedded assemblies; binding redirects stay in the generated .config for the
         non-embedded (bin folder) build and are evaluated in the spike (SPEC.md, "Jeden přenosný soubor"). -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TeamFoundationServer.ExtendedClient" Version="20.256.2" />
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TfPortable.Tests" />
    <InternalsVisibleTo Include="TfPortable.IntegrationTests" />
  </ItemGroup>

</Project>
